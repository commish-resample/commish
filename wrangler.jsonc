{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commish",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commish"
    }
  ],
  "vars": {
    "SITE_URL": "https://commish.fyi",
    "EMAIL_FROM": "Commish <hello@commish.fyi>",
    "ADMIN_EMAILS": ""
  },
  "observability": { "enabled": true }
  // Secrets, added in the Cloudflare dashboard (never in this file):
  // RESEND_API_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_MONTH, STRIPE_PRICE_YEAR
}
