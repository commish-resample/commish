{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commish",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commish"
    }
  ],
  "vars": {
    "SITE_URL": "https://commish.fyi",
    "EMAIL_FROM": "Commish <hello@commish.fyi>",
    "ADMIN_EMAILS": "commish.fyi.unable081@passmail.net",
    // Friends and testers who get Pro free (comma separated, no card needed).
    "PRO_EMAILS": "",
    // Stripe price ids (not secret). Test mode for now; swap for live ids at launch.
    "STRIPE_PRICE_MONTH": "price_1UdArIFikdM6areniLkSk7q3",
    "STRIPE_PRICE_YEAR": "price_1UdAszFikdM6arenb23vkHHA"
  },
  "observability": { "enabled": true }
  // Secrets, added in the Cloudflare dashboard (never in this file):
  // RESEND_API_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
}
