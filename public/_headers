/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://static.cloudflareinsights.com 'sha256-Xa0RQOGNhUrt2RHnWeOVTCrU3b5ttX+TSZeJl6oYf6I='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; form-action 'self'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/privacy
  Cache-Control: no-cache

/terms
  Cache-Control: no-cache

/refunds
  Cache-Control: no-cache

/media/*
  Cache-Control: public, max-age=31536000, immutable
